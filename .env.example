# Mandate — environment variables
#
# Copy this file to `.env` (which is gitignored) and adjust per environment.
# Anything left blank uses the default shown after `=`.

# ── Core ─────────────────────────────────────────────────────────────────
PORT=3000
MANDATE_HOST=0.0.0.0

# Path to the SQLite database file. Relative to where node is launched.
# In production, point this at a persistent volume (e.g. /data/mandate.db).
MANDATE_DB=./mandate.db

# ── Cookies / TLS ────────────────────────────────────────────────────────
# Force the `Secure` flag on all cookies. The server also auto-detects HTTPS
# from the request URL or X-Forwarded-Proto. Set to 1 if your TLS terminator
# doesn't pass a forwarded-proto header (rare).
# MANDATE_FORCE_SECURE_COOKIES=1

# ── Body size limits ─────────────────────────────────────────────────────
# Default 1MB on /api/*, 25MB on /api/workspace/backup/import.
# MANDATE_API_BODY_LIMIT=1000000
# MANDATE_IMPORT_BODY_LIMIT=25000000

# ── Static SPA serving ───────────────────────────────────────────────────
# When the built frontend (dist/) exists alongside server/, the API auto-serves
# it from the same origin. Force-enable with MANDATE_SERVE_STATIC=1.
# MANDATE_SERVE_STATIC=1

# ── Email backend ────────────────────────────────────────────────────────
# console (default) | resend | smtp | capture
# 'console' just logs the email to stdout — fine for local dev.
# 'capture' is for tests only — buffers in memory; do not use in production.
MANDATE_EMAIL_BACKEND=console
MANDATE_EMAIL_FROM=Mandate <noreply@mandate.app>

# Resend backend
# MANDATE_RESEND_KEY=re_xxxxxxxxxxxxxxxxxxxx

# SMTP backend (requires `npm i nodemailer`)
# MANDATE_SMTP_URL=smtp://user:pass@smtp.example.com:587

# ── Webhook worker ───────────────────────────────────────────────────────
# Stable identifier for this process — useful when running multiple workers.
# If unset, a random per-process id is generated.
# MANDATE_WORKER_ID=worker-prod-1
# MANDATE_WEBHOOK_TICK_MS=15000      # how often to poll for due retries
# MANDATE_WEBHOOK_LEASE_MS=60000     # how long a worker holds a claimed row
# MANDATE_WEBHOOK_BATCH=25           # max rows claimed per tick

# ── Reports worker ───────────────────────────────────────────────────────
# MANDATE_REPORTS_POLL_MS=60000

# ── Captcha (overrides for self-hosted siteverify endpoints — rare) ──────
# MANDATE_CAPTCHA_HCAPTCHA_URL=https://hcaptcha.com/siteverify
# MANDATE_CAPTCHA_TURNSTILE_URL=https://challenges.cloudflare.com/turnstile/v0/siteverify

# ── Test-only ────────────────────────────────────────────────────────────
# Disable rate limiting for E2E tests. NEVER set this in production.
# MANDATE_DISABLE_RATELIMIT=1

# ── Beacon (social) ────────────────────────────────────────────────
# Encrypts social access tokens & app secrets at rest (AES-256-GCM). REQUIRED in
# production; a dev fallback is used (insecurely) if unset.
MANDATE_SECRET_KEY=
# Absolute public origin, e.g. https://app.example.com. Needed so the scheduler
# can build public media URLs that Facebook/Instagram fetch, and short links.
MANDATE_PUBLIC_URL=
# Enables AI caption assist (Claude API). Optional.
ANTHROPIC_API_KEY=
# Override the AI model (default: claude-haiku-4-5-20251001).
MANDATE_AI_MODEL=
